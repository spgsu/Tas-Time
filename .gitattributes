# Normalise text to LF in the repository and working tree.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can misparse them.
*.cmd text eol=crlf

# macOS launcher scripts must keep LF or bash fails on the shebang line.
*.command text eol=lf

# Build output: committed so the app runs without Node, but collapsed in diffs.
dist/** linguist-generated=true -diff
